# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Godot text formats
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.import text eol=lf
*.cfg text eol=lf
*.shader text eol=lf
*.gdshader text eol=lf

# Documentation and scripts
*.md text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.py text eol=lf
*.json text eol=lf

# Binary assets tracked via Git LFS
*.png filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
